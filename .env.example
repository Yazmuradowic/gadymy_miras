# Copy this file to .env and fill in the values. Never commit .env.

PORT=3000

# MySQL
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=gadymy_miras

# Required: the server refuses to start without it.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Corporate mailbox (Hostinger SMTP) used to send contact-form emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=travel@gadymymiras.com
SMTP_PASS=YOUR_EMAIL_PASSWORD_HERE
# Address that receives contact-form messages
RECEIVER_EMAIL=travel@gadymymiras.com
