<%- include('adminpartials/header'); -%>
    <main class="admin-content">
        <section class="admin-section">
            <div class="admin-section-header">
                <h2>Habarlaryňyz</h2>
            </div>

            <% if (selectedMessage) { %>
                <div class="message-detail">
                    <div class="message-detail-header">
                        <div>
                            <h3><%= selectedMessage.name %></h3>
                            <p class="muted"><i class="fas fa-envelope"></i> <%= selectedMessage.email %></p>
                        </div>
                        <div class="message-detail-meta">
                            <span class="muted">
                                <i class="fas fa-clock"></i>
                                <%= selectedMessage.created_at ? selectedMessage.created_at.toLocaleString() : '' %>
                            </span>
                            <form action="/gadymymiras/admin/messages/<%= selectedMessage.id %>/delete" method="post"
                                  onsubmit="return confirm('Bu habary hakykatdanam pozmak isleýärsiňizmi?');">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn-ghost">
                                    <i class="fas fa-trash"></i> Poz
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="message-detail-body">
                        <p><%= selectedMessage.message %></p>
                    </div>
                </div>

                <div class="admin-divider"></div>
            <% } %>

            <% if (messages && messages.length) { %>
                <div class="messages-list">
                    <form id="messagesBulkForm" action="/gadymymiras/admin/messages/bulk-delete" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <div class="messages-bulk-actions">
                            <button type="submit" class="btn-outline" id="bulkDeleteBtn" disabled
                                    onclick="return confirm('Saýlanan habarlary hakykatdanam pozmak isleýärsiňizmi?');">
                                <i class="fas fa-trash"></i> Saýlananlary poz (<span id="bulkDeleteCount">0</span>)
                            </button>
                        </div>

                        <table class="messages-table">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="selectAllMessages"></th>
                                    <th>Ady</th>
                                    <th>Email</th>
                                    <th>Gelen wagty</th>
                                    <th>Status</th>
                                    <th>Hereket</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% messages.forEach(function(msg) { %>
                                    <tr class="<%= msg.is_read ? '' : 'unread' %>">
                                        <td><input type="checkbox" class="message-row-checkbox" name="ids" value="<%= msg.id %>"></td>
                                        <td><%= msg.name %></td>
                                        <td><%= msg.email %></td>
                                        <td>
                                            <%= msg.created_at ? msg.created_at.toLocaleString() : '' %>
                                        </td>
                                        <td class="status-badge-cell">
                                            <% if (msg.is_read) { %>
                                                <span class="badge badge-read">Okalan</span>
                                            <% } else { %>
                                                <span class="badge badge-unread">Täze</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/gadymymiras/admin/messages/<%= msg.id %>" class="btn-outline js-view-message">
                                                <i class="fas fa-eye"></i> Gör
                                            </a>
                                            <button type="submit" class="btn-ghost"
                                                    formaction="/gadymymiras/admin/messages/<%= msg.id %>/delete"
                                                    onclick="return confirm('Bu habary hakykatdanam pozmak isleýärsiňizmi?');">
                                                <i class="fas fa-trash"></i> Poz
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </form>
                </div>

                <div class="msg-modal-overlay" id="messageModalOverlay">
                    <div class="msg-modal" role="dialog" aria-modal="true" aria-labelledby="messageModalName">
                        <div class="msg-modal-header">
                            <div>
                                <h3 id="messageModalName"></h3>
                                <p class="muted"><i class="fas fa-envelope"></i> <span id="messageModalEmail"></span></p>
                            </div>
                            <div class="msg-modal-header-actions">
                                <span class="muted"><i class="fas fa-clock"></i> <span id="messageModalDate"></span></span>
                                <button type="button" class="msg-modal-close" id="messageModalCloseBtn" aria-label="Ýap">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                        <div class="msg-modal-body" id="messageModalBody"></div>
                        <div class="msg-modal-footer">
                            <form id="messageModalDeleteForm" method="post"
                                  onsubmit="return confirm('Bu habary hakykatdanam pozmak isleýärsiňizmi?');">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn-ghost">
                                    <i class="fas fa-trash"></i> Poz
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <script>
                    (function () {
                        var selectAll = document.getElementById('selectAllMessages');
                        var checkboxes = Array.prototype.slice.call(document.querySelectorAll('.message-row-checkbox'));
                        var bulkBtn = document.getElementById('bulkDeleteBtn');
                        var bulkCount = document.getElementById('bulkDeleteCount');

                        function updateBulkState() {
                            var checkedCount = checkboxes.filter(function (cb) { return cb.checked; }).length;
                            bulkCount.textContent = checkedCount;
                            bulkBtn.disabled = checkedCount === 0;
                            if (selectAll) {
                                selectAll.checked = checkedCount > 0 && checkedCount === checkboxes.length;
                                selectAll.indeterminate = checkedCount > 0 && checkedCount < checkboxes.length;
                            }
                        }

                        if (selectAll) {
                            selectAll.addEventListener('change', function () {
                                checkboxes.forEach(function (cb) { cb.checked = selectAll.checked; });
                                updateBulkState();
                            });
                        }

                        checkboxes.forEach(function (cb) {
                            cb.addEventListener('change', updateBulkState);
                        });

                        updateBulkState();
                    })();

                    (function () {
                        var overlay = document.getElementById('messageModalOverlay');
                        var closeBtn = document.getElementById('messageModalCloseBtn');
                        var deleteForm = document.getElementById('messageModalDeleteForm');
                        var navUnreadEl = document.querySelector('.nav-item[href="/gadymymiras/admin/messages"] .nav-unread-count');

                        function openModal(msg) {
                            document.getElementById('messageModalName').textContent = msg.name;
                            document.getElementById('messageModalEmail').textContent = msg.email;
                            document.getElementById('messageModalDate').textContent = msg.created_at;
                            document.getElementById('messageModalBody').textContent = msg.message;
                            deleteForm.action = '/gadymymiras/admin/messages/' + msg.id + '/delete';
                            overlay.classList.add('open');
                            document.body.classList.add('msg-modal-open');
                        }

                        function closeModal() {
                            overlay.classList.remove('open');
                            document.body.classList.remove('msg-modal-open');
                        }

                        closeBtn.addEventListener('click', closeModal);
                        overlay.addEventListener('click', function (e) {
                            if (e.target === overlay) closeModal();
                        });
                        document.addEventListener('keydown', function (e) {
                            if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
                        });

                        Array.prototype.slice.call(document.querySelectorAll('.js-view-message')).forEach(function (link) {
                            link.addEventListener('click', function (e) {
                                e.preventDefault();
                                var url = link.getAttribute('href');
                                var row = link.closest('tr');

                                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                                    .then(function (r) { return r.json(); })
                                    .then(function (data) {
                                        if (!data || !data.ok) {
                                            window.location.href = url;
                                            return;
                                        }
                                        openModal(data.message);
                                        if (row) {
                                            row.classList.remove('unread');
                                            var badgeCell = row.querySelector('.status-badge-cell');
                                            if (badgeCell) {
                                                badgeCell.innerHTML = '<span class="badge badge-read">Okalan</span>';
                                            }
                                        }
                                        if (navUnreadEl) {
                                            navUnreadEl.textContent = data.unreadMessages > 0 ? '(' + data.unreadMessages + ')' : '';
                                        }
                                    })
                                    .catch(function () {
                                        window.location.href = url;
                                    });
                            });
                        });
                    })();
                </script>
            <% } else { %>
                <p style="padding: 0.5rem 0; text-align:center; color:#e5e7eb;">
                    Entäk hiç hili habar ýok.
                </p>
            <% } %>
        </section>
    </main>
    <%- include('adminpartials/footer'); -%>

