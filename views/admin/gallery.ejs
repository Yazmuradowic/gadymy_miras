<%- include('adminpartials/header'); -%>
<% const pg = typeof pagination !== 'undefined' ? pagination : { page: 1, total: (photos || []).length }; %>
<% const maxFiles = typeof galleryMaxFiles !== 'undefined' ? galleryMaxFiles : 30; %>
<% const maxFileMb = typeof galleryMaxFileMb !== 'undefined' ? galleryMaxFileMb : 10; %>
    <main class="admin-content">
        <section class="admin-section">
            <div class="admin-section-header">
                <h2>Täze surat goşmak</h2>
            </div>

            <% if (error) { %>
                <div class="login-error" style="margin-bottom: 1rem;">
                    <i class="fas fa-exclamation-circle"></i>
                    <%= error %>
                </div>
            <% } %>
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="admin-success">
                    <i class="fas fa-check-circle"></i>
                    <%= success %>
                </div>
            <% } %>

            <form id="galleryUploadForm" action="/gadymymiras/admin/gallery" method="post" class="login-form"
                enctype="multipart/form-data" data-max-files="<%= maxFiles %>" data-max-file-mb="<%= maxFileMb %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label for="image_files"><i class="fas fa-images"></i> Surat faýllary</label>
                    <input type="file" id="image_files" name="image_files" accept="image/*" multiple>
                    <p class="form-hint">
                        Birnäçe suraty birbada saýlap bolýar (Ctrl ýa-da Shift basyp saklap).
                        Bir gezekde iň köp <%= maxFiles %> surat, her biri <%= maxFileMb %> MB-dan uly bolmaly däl.
                    </p>
                    <div id="galleryUploadPreview" class="upload-preview" hidden></div>
                </div>
                <div class="form-group">
                    <label for="image_url"><i class="fas fa-link"></i> Ýa-da URL adresi (islege görä)</label>
                    <input type="text" id="image_url" name="image_url"
                        placeholder="Mysal: /image/galery/1.webp ýa-da https://...">
                </div>
                <button id="galleryUploadSubmit" type="submit" class="btn-login">Goş</button>

                <div id="galleryUploadProgress" class="upload-progress" hidden>
                    <div class="upload-progress__top">
                        <div class="upload-progress__label">Ýüklenýär...</div>
                        <div class="upload-progress__percent">0%</div>
                    </div>
                    <div class="upload-progress__bar">
                        <div class="upload-progress__bar-fill" style="width:0%;"></div>
                    </div>
                </div>
                <div id="galleryUploadError" class="upload-progress__error" role="alert" hidden></div>
            </form>
        </section>

        <section class="admin-section" style="margin-top: 1.5rem;">
            <div class="admin-section-header admin-list-header">
                <h2>Bar bolan suratlar <span class="admin-count">(<%= pg.total %>)</span></h2>

                <% if (photos && photos.length) { %>
                    <form id="galleryBulkForm" class="bulk-actions js-bulk-form"
                        action="/gadymymiras/admin/gallery/bulk-delete" method="post"
                        data-confirm="Saýlanan suratlary hakykatdanam pozmak isleýärsiňizmi?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="page" value="<%= pg.page %>">
                        <label class="bulk-select-all">
                            <input type="checkbox" class="js-select-all"> Şu sahypadakylaryň hemmesini saýla
                        </label>
                        <button type="submit" class="btn-ghost js-bulk-submit" disabled>
                            <i class="fas fa-trash"></i> Saýlananlary poz (<span class="js-bulk-count">0</span>)
                        </button>
                    </form>
                <% } %>
            </div>

            <% if (photos && photos.length) { %>
                <div class="gallery-grid">
                    <% photos.forEach(function(photo) { %>
                        <div class="gallery-item js-selectable" style="position: relative;">
                            <img src="<%= photo.gallery_url %>" alt="Gallery photo" loading="lazy">
                            <div
                                style="position:absolute; inset:0; background:linear-gradient(to top, rgba(15,23,42,0.9), transparent 60%); display:flex; flex-direction:column; justify-content:flex-end; padding:0.75rem; gap:0.35rem;">
                                <form action="/gadymymiras/admin/gallery/<%= photo.id %>/update" method="post"
                                    enctype="multipart/form-data"
                                    style="display:flex; flex-direction:column; gap:0.35rem;">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="page" value="<%= pg.page %>">
                                    <input type="file" name="image_file" accept="image/*"
                                        style="padding:0.15rem 0.4rem; border-radius:6px; border:none; font-size:0.78rem; background:rgba(15,23,42,0.9); color:#e5e7eb;">
                                    <input type="text" name="image_url" value="<%= photo.gallery_url %>"
                                        placeholder="URL (islege görä)"
                                        style="padding:0.25rem 0.4rem; border-radius:6px; border:none; font-size:0.8rem;">
                                    <button type="submit"
                                        style="padding:0.25rem 0.4rem; border-radius:999px; border:none; font-size:0.75rem; font-weight:600; cursor:pointer; background:#38bdf8; color:#0f172a;">Üýtget</button>
                                </form>
                                <form action="/gadymymiras/admin/gallery/<%= photo.id %>/delete" method="post"
                                    data-confirm="Bu suraty hakykatdanam pozmak isleýärsiňizmi?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="page" value="<%= pg.page %>">
                                    <button type="submit"
                                        style="margin-top:0.25rem; padding:0.2rem 0.4rem; border-radius:999px; border:1px solid rgba(248,113,113,0.8); font-size:0.75rem; font-weight:600; cursor:pointer; background:rgba(127,29,29,0.9); color:#fecaca;">
                                        Poz
                                    </button>
                                </form>
                            </div>
                            <label class="select-badge" title="Köpçülikleýin pozmak üçin saýla">
                                <input type="checkbox" class="js-select-item" name="ids" value="<%= photo.id %>"
                                    form="galleryBulkForm">
                                <span>Saýla</span>
                            </label>
                        </div>
                    <% }) %>
                </div>

                <%- include('../partials/pagination'); -%>
            <% } else { %>
                <p style="padding: 0.5rem 0; text-align:center; color:#e5e7eb;">Galereýada entek surat ýok.</p>
            <% } %>
        </section>
    </main>
    <%- include('adminpartials/footer'); -%>
